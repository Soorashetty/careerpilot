# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/careerpilot

# JWT (required) - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI (required)
GROQ_API_KEY=your-groq-api-key

# Job APIs (optional - leave blank to disable)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JSEARCH_API_KEY=your-jsearch-api-key

# Redis (optional - for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# CORS - set to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# Environment: development | production
ENVIRONMENT=development
